# ── Database (MySQL / MariaDB) ────────────────────────────────────
# Ada DUA cara koneksi yang dipakai projek ini, dan keduanya wajib diisi:
#
#   1. DATABASE_URL  -> dipakai Prisma CLI (prisma migrate, prisma generate)
#                       lewat prisma.config.ts
#   2. DB_*          -> dipakai aplikasi saat runtime, karena
#                       src/config/prisma.js membuat pool MariaDB dari objek
#                       konfigurasi, bukan dari URL
#
# Isi keduanya menunjuk ke database yang SAMA. Kalau tidak, migration dan
# aplikasi akan bekerja di database yang berbeda.

# contoh: mysql://user:password@localhost:3306/finsense_db
DATABASE_URL={{ DATABASE_URL }}
# opsional, koneksi non-pooled untuk prisma migrate (Neon/PlanetScale dsb.)
DIRECT_URL={{ DIRECT_URL }}

# default di kode: localhost
DB_HOST={{ DB_HOST }}
# default di kode: 3306
DB_PORT={{ DB_PORT }}
# default di kode: root
DB_USER={{ DB_USER }}
# default di kode: kosong
DB_PASSWORD={{ DB_PASSWORD }}
# default di kode: finsense_db
DB_NAME={{ DB_NAME }}

# ── Server ────────────────────────────────────────────────────────
PORT={{ PORT }}
# development | production — mengatur level log Prisma
NODE_ENV={{ NODE_ENV }}
JWT_SECRET={{ JWT_SECRET }}
# dipakai untuk menyusun link reset password
FRONTEND_URL={{ FRONTEND_URL }}

# ── Layanan AI (FastAPI) ──────────────────────────────────────────
# endpoint /voice — model produk CNN-BiGRU-CTC
# WAJIB diakhiri garis miring: tanpa itu FastAPI membalas 307 redirect dan
# unggahan audio rusak (lihat src/controllers/voiceController.js)
AI_SERVICE_URL={{ AI_SERVICE_URL }}
# endpoint /predict
PREDICTION_SERVICE_URL={{ PREDICTION_SERVICE_URL }}

# ── Email (nodemailer) ────────────────────────────────────────────
MAIL_HOST={{ MAIL_HOST }}
MAIL_PORT={{ MAIL_PORT }}
# "true" untuk port 465, "false" untuk 587
MAIL_SECURE={{ MAIL_SECURE }}
MAIL_USER={{ MAIL_USER }}
MAIL_PASSWORD={{ MAIL_PASSWORD }}
# alamat pengirim yang tampil di email
EMAIL_FROM={{ EMAIL_FROM }}

# ── Seeder (opsional) ─────────────────────────────────────────────
# UUID user target untuk prisma/seedAiDummy.js
SEED_USER_ID={{ SEED_USER_ID }}
