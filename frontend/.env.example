# Example environment variables for the frontend application
VITE_API_URL={{ VITE_API_URL }}
VITE_VOICE_AI_URL={{ VITE_VOICE_AI_URL }}
VITE_PRED_AI_URL={{ VITE_PRED_AI_URL }}

# Saklar ASR pihak ketiga (Web Speech API bawaan browser).
# Kosong / false (bawaan): sistem memakai model CNN-BiGRU-CTC sendiri —
#   berjalan tanpa internet dan tanpa mengirim suara ke layanan luar.
# true: transkrip browser ikut dipakai untuk jumlah dan jalur cadangan.
#   Setel bersama FINSENSE_ASR_MODE=hybrid di layanan AI.
VITE_PAKAI_WEB_SPEECH=false
